# --- Server ---
PORT=8090

# Allow the web app (Vite dev server) to call this API.
CORS_ORIGIN=http://localhost:5173

# --- iMouse kernel (the Windows box that controls the phones) ---
# Host/IP of the machine running the iMouse kernel. Port 9911 is the kernel API.
KERNEL_HOST=192.168.70.170
KERNEL_PORT=9911

# --- Google Drive (source of videos to post) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8090/api/drive/callback
GOOGLE_DRIVE_FOLDER_ID=

# --- Where downloaded videos are saved before pushing to the phone ---
# UPLOAD_DIR = where THIS machine (the Mac) writes the download.
#   If the Windows box shares C:\iMouseXP\uploads and the Mac mounts it,
#   set this to the mount, e.g. /Volumes/uploads
# KERNEL_UPLOAD_DIR = the SAME folder as the iMouse kernel (Windows) sees it.
#   The album command needs the Windows-style path. Leave blank if the backend
#   runs directly on the kernel host (then UPLOAD_DIR is used for both).
UPLOAD_DIR=/Volumes/uploads
KERNEL_UPLOAD_DIR=C:\iMouseXP\uploads
